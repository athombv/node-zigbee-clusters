{
  "name": "zigbee-clusters",
  "version": "3.9.0",
  "description": "Zigbee Cluster Library for Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec --test-timeout=5000 \"test/*.js\"",
    "lint": "eslint .",
    "generate-types": "node scripts/generate-types.mts",
    "build": "jsdoc --configure ./docs/jsdoc.json",
    "docs": "npm run build && open build/index.html",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/athombv/node-zigbee-clusters.git"
  },
  "keywords": [
    "zigbee",
    "cluster",
    "library"
  ],
  "author": "Athom B.V.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/athombv/node-zigbee-clusters/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/athombv/node-zigbee-clusters#readme",
  "devDependencies": {
    "@athombv/jsdoc-template": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.10",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdoc": "^4.0.5",
    "jsdoc-ts-utils": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@athombv/data-types": "^1.3.0",
    "debug": "^4.1.1"
  }
}
